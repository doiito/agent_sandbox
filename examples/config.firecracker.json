{
  "listen": "127.0.0.1:8080",
  "artifact_root": "/var/lib/osv-sandbox/artifacts",
  "run_root": "/run/osv-sandbox",
  "backend": "firecracker",
  "hypervisor_path": "/usr/local/bin/firecracker",
  "jailer": {
    "path": "/usr/local/bin/jailer",
    "uid": 65534,
    "gid": 65534,
    "cgroup_version": 2,
    "memory_overhead_mib": 128,
    "no_file_limit": 128
  },
  "kernel": {
    "path": "loader-stripped.elf",
    "sha256": "REPLACE_WITH_64_HEX_CHARACTERS"
  },
  "image": {
    "path": "agent-rofs.raw",
    "sha256": "REPLACE_WITH_64_HEX_CHARACTERS",
    "format": "raw"
  },
  "allowed_entrypoints": ["/agent"],
  "defaults": {"memory_mib": 128, "vcpus": 1, "timeout_ms": 30000},
  "limits": {
    "max_concurrent": 16,
    "min_memory_mib": 32,
    "max_memory_mib": 1024,
    "max_vcpus": 2,
    "max_timeout_ms": 300000,
    "max_output_bytes": 1048576
  }
}
