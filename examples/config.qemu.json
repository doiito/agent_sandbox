{
  "listen": "127.0.0.1:8080",
  "artifact_root": "/var/lib/osv-sandbox/artifacts",
  "run_root": "/run/osv-sandbox",
  "backend": "qemu",
  "hypervisor_path": "/usr/bin/qemu-system-x86_64",
  "kernel": {
    "path": "loader-stripped.elf",
    "sha256": "REPLACE_WITH_64_HEX_CHARACTERS"
  },
  "image": {
    "path": "agent-rofs.img",
    "sha256": "REPLACE_WITH_64_HEX_CHARACTERS",
    "format": "qcow2"
  },
  "allowed_entrypoints": ["/agent"],
  "defaults": {"memory_mib": 128, "vcpus": 1, "timeout_ms": 30000},
  "limits": {
    "max_concurrent": 16,
    "min_memory_mib": 32,
    "max_memory_mib": 1024,
    "max_vcpus": 2,
    "max_timeout_ms": 300000,
    "max_output_bytes": 1048576
  }
}
