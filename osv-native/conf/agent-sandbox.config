#
# Automatically generated file; DO NOT EDIT.
# OSv Configuration
#

#
# Compiler
#
CONF_compiler_opt=" -O2 -DNDEBUG"
CONF_compiler_cflags=" -msse2"
CONF_compiler_cxx_level="gnu++14"
# end of Compiler

#
# Core Components
#
# CONF_tracing is not set
# CONF_logger_debug is not set
CONF_hide_symbols=y
# CONF_elf_debug is not set
CONF_core_c_wrappers=y
CONF_core_commands_runscript=y
CONF_core_namespaces=y
CONF_core_dynamic_percpu_size=65536
CONF_core_rcu_defer_queue_size=2000
CONF_core_debug_buffer_size=0xc800
CONF_core_syscall=y
CONF_core_epoll=y
# CONF_core_newpoll is not set
# end of Core Components

#
# Threading
#
CONF_preempt=y
# CONF_lazy_stack is not set
# CONF_lazy_stack_invariant is not set
CONF_threads_default_kernel_stack_size=65536
CONF_threads_default_pthread_stack_size=0x100000
CONF_interrupt_stack_size=0x1000
CONF_syscall_stack_size=0x800
# end of Threading

#
# Virtual File System
#
CONF_fs_procfs=y
CONF_fs_sysfs=y
CONF_fs_max_file_descriptors=0x4000
CONF_fs_buffer_cache_size=256
# end of Virtual File System

#
# Memory Management
#
CONF_memory_optimize=y
# CONF_memory_debug is not set
# CONF_memory_tracker is not set
# CONF_memory_jvm_balloon is not set
CONF_memory_l1_pool_size=512
CONF_memory_page_batch_size=32
# end of Memory Management

#
# Networking Stack
#
# CONF_networking_stack is not set
# end of Networking Stack

#
# Tracepoints
#
CONF_tracepoints=y
CONF_tracepoints_sampler=y
CONF_tracepoints_strace=y
# CONF_tracepoints_callstack is not set
# end of Tracepoints

#
# Application
#
CONF_version_script="build/release.x64/default_version_script"
CONF_syscalls_list_file=""
# end of Application

