[Unit]
Description=Authenticated HTTP Egress for Agent Sandbox
Documentation=file:/usr/share/doc/osv-sandbox/EGRESS.zh-CN.md
After=network-online.target

[Service]
Type=simple
User=osv-sandbox
Group=osv-sandbox
ExecStart=/usr/local/bin/osv-sandbox-egress -config /etc/osv-sandbox/egress.production.json
RuntimeDirectory=osv-sandbox-egress
RuntimeDirectoryMode=0700
StateDirectory=osv-sandbox-egress
StateDirectoryMode=0700
LogsDirectory=osv-sandbox-egress
LogsDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/osv-sandbox
ReadWritePaths=/run/osv-sandbox-egress /var/log/osv-sandbox-egress /var/lib/osv-sandbox-egress
MemoryMax=256M
CPUQuota=100%
TasksMax=128
LimitNOFILE=1024
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
